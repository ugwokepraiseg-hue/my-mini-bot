# COINVERA configuration
# Copy to .env for local runs. On AppJet, set these in Settings → Environment variables.

# Telegram bot token from @BotFather. Required for the bot and for Mini App auth.
BOT_TOKEN=

# Telegram ID that can open the admin dashboard.
ADMIN_TELEGRAM_ID=8463629333

# Public https URL of the Mini App. Optional: when empty, the app remembers the
# origin of the first incoming request.
WEBAPP_URL=

# HTTP port (AppJet provides this automatically).
PORT=3000

# Where the SQLite database lives.
DATA_DIR=./data
